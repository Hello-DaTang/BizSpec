{
  "name": "@hello-datang/bizspec",
  "version": "0.3.0",
  "description": "Stateful business discovery workflow and project-scoped agent skill installer.",
  "type": "module",
  "bin": {
    "bizspec": "./dist/bin.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "agents",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:compile": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && npm run test:compile && node --test .test-dist/test/cli.test.js",
    "prepare": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "agent-skills",
    "business-analysis",
    "requirements",
    "codex",
    "claude-code",
    "github-copilot",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hello-DaTang/BizSpec.git"
  },
  "bugs": {
    "url": "https://github.com/Hello-DaTang/BizSpec/issues"
  },
  "homepage": "https://github.com/Hello-DaTang/BizSpec#readme",
  "publishConfig": {
    "access": "public"
  }
}
